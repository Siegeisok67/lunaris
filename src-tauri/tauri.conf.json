{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunaris",
  "version": "0.1.1",
  "identifier": "com.lunaris.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lunaris",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "AI prompt middleware for desktop workflows",
    "longDescription": "Lunaris clarifies rough requests, matches technical skills, and compiles execution-ready plans.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQjZFOUMyNkVDRkMxMjQKUldRa3djOXV3dW0ycm1RUmpWZlhRaXZRSkRKSWhKenUxOVlWcEFnM29mZytHcmhkc0gwOUdEb24K",
      "endpoints": [
        "https://github.com/Siegeisok67/lunaris/releases/latest/download/latest.json"
      ]
    }
  }
}
